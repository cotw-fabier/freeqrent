{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/freeqrent/freeqrent/schema/freeqrent.schema.json",
  "title": "freeQRent Style document",
  "x-freeqrent-version": "1.0.0",
  "$ref": "#/$defs/Style",
  "$defs": {
    "Style": {
      "description": "A Style document (SPEC §10.1). Every key is optional.",
      "type": "object",
      "properties": {
        "preset": {
          "description": "The base style: a preset (Style::preset).",
          "enum": [
            "classic",
            "ink",
            "candy",
            "terminal",
            "sunset",
            "bubble",
            "ribbon",
            "leaf"
          ]
        },
        "art": {
          "description": "The base style: art mode for this picture (Style::art). Not with preset or halftone.",
          "$ref": "#/$defs/Halftone"
        },
        "modules": {
          "$ref": "#/$defs/ModuleShape"
        },
        "finders": {
          "$ref": "#/$defs/Finders"
        },
        "alignment": {
          "$ref": "#/$defs/Alignment"
        },
        "timing": {
          "enum": [
            "plain",
            "dotted",
            "dashed"
          ]
        },
        "palette": {
          "description": "Token paints, merged onto the base's palette.",
          "$ref": "#/$defs/Palette"
        },
        "dark": {
          "description": "Render the palette's dark twin and allow inverted colors.",
          "type": "boolean"
        },
        "quiet_zone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "allow_inverted": {
          "type": "boolean"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "border": {
          "$ref": "#/$defs/Border"
        },
        "shadow": {
          "description": "A hard shadow's offset down and right, in modules (0.25–3).",
          "type": "number"
        },
        "color_spread": {
          "description": "How data modules share fg and the data colors fg.2 to fg.4.",
          "enum": [
            "modules",
            "regions"
          ]
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "logo": {
          "$ref": "#/$defs/Logo"
        },
        "halftone": {
          "$ref": "#/$defs/Halftone"
        },
        "intro": {
          "$ref": "#/$defs/Intro"
        },
        "idle": {
          "type": "array",
          "items": {
            "enum": [
              "finder-pulse",
              "shimmer",
              "breathe",
              "logo-glint",
              "logo-turn",
              "logo-spin",
              "logo-flip"
            ]
          }
        },
        "theme_transition_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "id_prefix": {
          "type": "string"
        },
        "target_size": {
          "$ref": "#/$defs/TargetSize"
        },
        "minify": {
          "type": "boolean"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        }
      },
      "additionalProperties": false
    },
    "ModuleShape": {
      "oneOf": [
        {
          "enum": [
            "square",
            "rounded",
            "dots",
            "liquid",
            "bars"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "square"
            },
            "gap": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rounded"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dots"
            },
            "size": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "liquid"
            },
            "smoothness": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bars"
            },
            "axis": {
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Ring": {
      "oneOf": [
        {
          "enum": [
            "square",
            "rounded",
            "squircle",
            "leaf"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "square"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "squircle"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "leaf"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rounded"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Eye": {
      "oneOf": [
        {
          "enum": [
            "square",
            "rounded",
            "circle",
            "squircle",
            "leaf"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "square"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "squircle"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "leaf"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rounded"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RingAndEye": {
      "type": "object",
      "properties": {
        "ring": {
          "$ref": "#/$defs/Ring"
        },
        "eye": {
          "$ref": "#/$defs/Eye"
        }
      },
      "additionalProperties": false
    },
    "Finders": {
      "type": "object",
      "properties": {
        "ring": {
          "$ref": "#/$defs/Ring"
        },
        "eye": {
          "$ref": "#/$defs/Eye"
        },
        "corners": {
          "type": "object",
          "properties": {
            "top-left": {
              "$ref": "#/$defs/RingAndEye"
            },
            "top-right": {
              "$ref": "#/$defs/RingAndEye"
            },
            "bottom-left": {
              "$ref": "#/$defs/RingAndEye"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Alignment": {
      "type": "object",
      "properties": {
        "shape": {
          "oneOf": [
            {
              "enum": [
                "match"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "match"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "own"
                },
                "ring": {
                  "$ref": "#/$defs/Ring"
                },
                "eye": {
                  "$ref": "#/$defs/Eye"
                }
              },
              "required": [
                "kind",
                "ring"
              ],
              "additionalProperties": false
            }
          ]
        },
        "emphasis": {
          "enum": [
            "none",
            "accent",
            "outline"
          ]
        }
      },
      "additionalProperties": false
    },
    "Palette": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "bg",
          "fg",
          "finder.outer",
          "finder.eye",
          "alignment",
          "timing",
          "filler",
          "logo.backdrop",
          "frame",
          "finder.top-left.outer",
          "finder.top-right.outer",
          "finder.bottom-left.outer",
          "finder.top-left.eye",
          "finder.top-right.eye",
          "finder.bottom-left.eye",
          "logo.frame",
          "shadow",
          "fg.2",
          "fg.3",
          "fg.4"
        ]
      },
      "additionalProperties": {
        "description": "A CSS paint: a color, or a gradient where the token takes one.",
        "type": "string"
      }
    },
    "Frame": {
      "oneOf": [
        {
          "enum": [
            "square",
            "rounded",
            "circle",
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "square"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rounded"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "filler_density": {
              "type": "number"
            },
            "ring": {
              "enum": [
                "none",
                "solid",
                "dashed"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Border": {
      "oneOf": [
        {
          "enum": [
            "solid",
            "double"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "solid"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "double"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Effect": {
      "description": "A filter on the code: a glow in its own colors (radius 0.05–0.5 modules, default 0.3; strength 0–0.25, default 0.25) or an emboss (depth 0.05–0.12, default 0.1).",
      "oneOf": [
        {
          "enum": [
            "glow",
            "emboss"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "glow"
            },
            "radius": {
              "type": "number"
            },
            "strength": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "emboss"
            },
            "depth": {
              "type": "number"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Logo": {
      "type": "object",
      "properties": {
        "svg": {
          "description": "An SVG document; it is sanitized.",
          "type": "string"
        },
        "raster": {
          "description": "PNG, JPEG, GIF or WebP bytes.",
          "$ref": "#/$defs/Base64"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "largest"
          ]
        },
        "scale": {
          "type": "number"
        },
        "frame": {
          "oneOf": [
            {
              "enum": [
                "ring",
                "beads",
                "stamp",
                "brackets",
                "orbit"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ring"
                },
                "width": {
                  "type": "number"
                },
                "moon": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "beads"
                },
                "width": {
                  "type": "number"
                },
                "moon": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "stamp"
                },
                "width": {
                  "type": "number"
                },
                "moon": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "brackets"
                },
                "width": {
                  "type": "number"
                },
                "moon": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "orbit"
                },
                "width": {
                  "type": "number"
                },
                "moon": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "shape": {
          "oneOf": [
            {
              "enum": [
                "square",
                "rounded",
                "circle"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "square"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "circle"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "rounded"
                },
                "radius": {
                  "type": "number"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "padding": {
          "type": "number"
        },
        "backdrop": {
          "type": "boolean"
        },
        "clear_modules": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "svg"
          ]
        },
        {
          "required": [
            "raster"
          ]
        }
      ]
    },
    "Base64": {
      "description": "Standard base64 (RFC 4648); padding optional.",
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "Image": {
      "description": "Raw pixels.",
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rgba": {
          "description": "8-bit RGBA, row by row.",
          "$ref": "#/$defs/Base64"
        }
      },
      "required": [
        "width",
        "height",
        "rgba"
      ],
      "additionalProperties": false
    },
    "Halftone": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/Image"
        },
        "ink": {
          "oneOf": [
            {
              "enum": [
                "mono",
                "color"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "mono"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "color"
                },
                "colors": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "clarity": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/Image"
            }
          ]
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "focal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "priority": {
          "$ref": "#/$defs/Image"
        },
        "steer": {
          "type": "boolean"
        }
      },
      "required": [
        "image"
      ],
      "additionalProperties": false
    },
    "Intro": {
      "oneOf": [
        {
          "enum": [
            "settle",
            "ripple",
            "lock-on",
            "sweep",
            "raster",
            "iris",
            "assemble",
            "develop"
          ]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "enum": [
                "settle",
                "ripple",
                "lock-on",
                "sweep",
                "raster",
                "iris",
                "assemble",
                "develop"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "ease": {
              "$ref": "#/$defs/Ease"
            },
            "stagger": {
              "$ref": "#/$defs/Stagger"
            },
            "groups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "trigger": {
              "$ref": "#/$defs/Trigger"
            },
            "logo": {
              "enum": [
                "none",
                "reveal",
                "stamp",
                "draw",
                "lock",
                "ink",
                "shrink",
                "spin"
              ]
            },
            "logo_timing": {
              "enum": [
                "after",
                "before",
                "with"
              ]
            },
            "frame": {
              "enum": [
                "none",
                "reveal",
                "stamp",
                "draw",
                "lock",
                "ink",
                "shrink",
                "spin"
              ]
            },
            "frame_timing": {
              "enum": [
                "after",
                "before",
                "with"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "A palette shift: the code's colors cross-fade from palette_from.",
          "type": "object",
          "properties": {
            "palette_from": {
              "$ref": "#/$defs/Palette"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "ease": {
              "$ref": "#/$defs/Ease"
            },
            "trigger": {
              "$ref": "#/$defs/Trigger"
            }
          },
          "required": [
            "palette_from"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Ease": {
      "oneOf": [
        {
          "enum": [
            "quart",
            "quint",
            "expo"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quart"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "quint"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "expo"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custom"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Stagger": {
      "oneOf": [
        {
          "enum": [
            "radial",
            "linear",
            "diagonal",
            "polar",
            "random"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "radial"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linear"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
